# =========================
# Flask / App
# =========================
SECRET_KEY=thay-secret-key-cua-ban-vao-day
SQLALCHEMY_DATABASE_URI=sqlite:///bus_booking.db
UPLOAD_FOLDER=static/uploads/food

# =========================
# Mail
# =========================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER_NAME=HUTECH BUS
MAIL_DEFAULT_SENDER_EMAIL=your-email@gmail.com

# =========================
# PayOS
# =========================
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# =========================
# AI (optional)
# =========================

# Tùy chọn: trợ lý web gửi yêu cầu tìm chuyến chưa đủ rõ tới Gemini.
# Giữ khóa trong .env trên máy chủ. Để trống để chỉ dùng bộ xử lý nội bộ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# =========================
# JWT / Mobile App API
# =========================
JWT_SECRET_KEY=thay-jwt-secret-key-cua-ban-vao-day
JWT_ACCESS_TOKEN_EXPIRES=3600
