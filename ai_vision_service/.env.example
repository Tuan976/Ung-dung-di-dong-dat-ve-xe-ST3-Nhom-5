# AI Vision Service Configuration
VISION_HOST=127.0.0.1
VISION_PORT=5050
VISION_DEBUG=false

# Ollama Backend
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Selected vision model based on hardware testing (Qwen2.5-VL / Qwen3-VL / Moondream)
VISION_MODEL=qwen2.5-vl:3b

# Security & API Protection
# Use this Bearer token in client requests: Authorization: Bearer <API_TOKEN>
VISION_API_TOKEN=vexekhach_ai_vision_sec_2026_tok

# Rate Limiting & Upload constraints
MAX_CONTENT_LENGTH_MB=10
REQUEST_TIMEOUT_SECONDS=45
MAX_CONCURRENT_REQUESTS=2

# Main Bus Backend (for booking/ticket validation verification)
MAIN_BACKEND_URL=https://vexekhach.aweb.io.vn/api/v1
